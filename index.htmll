<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Melodic Formula - Interactive Masterclass (Guitar Playback Style)</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent: #38bdf8;
            --accent-glow: rgba(56, 189, 248, 0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
            --danger: #f43f5e;
            --success: #10b981;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            padding: 20px;
        }

        header {
            text-align: center;
            padding: 40px 20px;
            max-width: 900px;
            margin: 0 auto;
        }

        header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        .container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        .card h2 {
            margin-bottom: 15px;
            font-size: 1.5rem;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card p {
            color: var(--text-muted);
            margin-bottom: 20px;
        }

        /* Formula Steps Container */
        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .step-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border);
            padding: 20px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .step-card:hover, .step-card.active {
            border-color: var(--accent);
            box-shadow: 0 0 15px var(--accent-glow);
            transform: translateY(-2px);
        }

        .step-card h3 {
            color: var(--text-main);
            margin-bottom: 8px;
            font-size: 1.1rem;
        }

        /* Interactive Fretboard */
        .fretboard-container {
            overflow-x: auto;
            padding-bottom: 15px;
            margin: 20px 0;
        }

        .fretboard {
            display: grid;
            grid-template-rows: repeat(6, 35px);
            grid-template-columns: 50px repeat(13, minmax(45px, 1fr));
            background: #090d16;
            border: 3px solid #475569;
            border-radius: 6px;
            min-width: 700px;
            padding: 10px 0;
        }

        .string-label {
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--text-muted);
            background: #1e293b;
            border-right: 2px solid #64748b;
            font-size: 0.9rem;
        }

        .fret-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            border-right: 2px solid #475569;
            position: relative;
            cursor: pointer;
        }

        /* String lines across frets */
        .fret-cell::after {
            content: '';
            position: absolute;
            height: 2px;
            width: 100%;
            background: #64748b;
            top: 50%;
            transform: translateY(-50%);
            z-index: 1;
        }

        .fret-cell.nut {
            border-right: 5px solid #cbd5e1;
        }

        .note-marker {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--card-bg);
            border: 2px solid var(--border);
            color: var(--text-muted);
            font-size: 0.75rem;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2;
            transition: transform 0.1s, background 0.2s;
        }

        .note-marker:hover {
            transform: scale(1.15);
        }

        .note-marker.target {
            background: var(--accent);
            border-color: #fff;
            color: #0f172a;
            box-shadow: 0 0 10px var(--accent);
        }

        .note-marker.root {
            background: var(--danger);
            border-color: #fff;
            color: #fff;
            box-shadow: 0 0 10px var(--danger);
        }

        /* Controls & Buttons */
        .controls-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 20px;
            align-items: center;
        }

        button {
            background-color: var(--accent);
            color: #0f172a;
            border: none;
            padding: 10px 20px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.1s;
        }

        button:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

        button.secondary {
            background-color: transparent;
            border: 1px solid var(--accent);
            color: var(--accent);
        }

        button.secondary:hover {
            background-color: rgba(56, 189, 248, 0.1);
        }

        select {
            background: #0f172a;
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 10px;
            border-radius: 6px;
            outline: none;
        }

        /* Player simulator display */
        .player-display {
            background: #090d16;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 20px;
            text-align: center;
            margin-top: 15px;
        }

        .tab-display {
            font-family: monospace;
            font-size: 1.2rem;
            color: var(--accent);
            letter-spacing: 2px;
            margin: 10px 0;
            white-space: pre-wrap;
        }

        .status-text {
            font-size: 0.95rem;
            color: var(--text-muted);
        }

        /* Legend */
        .legend {
            display: flex;
            gap: 20px;
            margin-top: 15px;
            font-size: 0.85rem;
            color: var(--text-muted);
            align-items: center;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .legend-dot.root { background: var(--danger); }
        .legend-dot.target { background: var(--accent); }
        .legend-dot.normal { background: var(--border); }
    </style>
</head>
<body>

    <header>
        <h1>The Melodic Formula Masterclass</h1>
        <p>Interactive breakdown inspired by David Wallimann’s Guitar Playback method. Stop wandering through pentatonic boxes and start building memorable musical themes.</p>
    </header>

    <div class="container">

        <!-- Core Concept Card -->
        <div class="card">
            <h2>🎵 What is the Melodic Formula?</h2>
            <p>Most guitarists get stuck looping scales up and down without telling a story. The Melodic Formula teaches you how to construct short, catchy vocal-like motifs (hooks), twist them with rhythmic variations, and resolve them cleanly so listeners stay hooked.</p>
            
            <div class="steps-grid">
                <div class="step-card active" onclick="setFormulaStep(0)">
                    <h3>Step 1: The Hook Motif</h3>
                    <p>Create a short, simple 3-to-4 note phrase anchored around a strong structural chord tone interval.</p>
                </div>
                <div class="step-card" onclick="setFormulaStep(1)">
                    <h3>Step 2: Sequence & Variation</h3>
                    <p>Take that exact motif and shift it up or down the scale sequence to create dynamic tension and narrative movement.</p>
                </div>
                <div class="step-card" onclick="setFormulaStep(2)">
                    <h3>Step 3: The Resolution</h3>
                    <p>Bring the listener home by landing firmly on a stable target tone (Root or Major 3rd) over the chord change.</p>
                </div>
            </div>
        </div>

        <!-- Interactive Fretboard & Note Player -->
        <div class="card">
            <h2>🎸 Interactive Fretboard & Note Explorer</h2>
            <p>Click any highlighted note on the fretboard below to hear its pitch and see how it fits into a melodic cell. (Standard Tuning: E-A-D-G-B-E in key of A Minor/Major)</p>

            <div class="controls-group">
                <label for="scaleSelect">Select Position Focus:</label>
                <select id="scaleSelect" onchange="updateFretboard()">
                    <option value="formula">Melodic Formula Core Notes (A Minor Pentatonic + Target Tones)</option>
                    <option value="pentatonic">A Minor Pentatonic Box 1</option>
                    <option value="triad">A Minor Triad Targets (A, C, E)</option>
                </select>
                <button class="secondary" onclick="playCurrentMotif()">▶ Play Sample Motif</button>
            </div>

            <div class="fretboard-container">
                <div class="fretboard" id="fretboardGrid">
                    <!-- Dynamic generation via JS -->
                </div>
            </div>

            <div class="legend">
                <div class="legend-item"><div class="legend-dot root"></div>Root Note (A)</div>
                <div class="legend-item"><div class="legend-dot target"></div>Melodic Target Tone</div>
                <div class="legend-item"><div class="legend-dot normal"></div>Scale Tone</div>
            </div>
        </div>

        <!-- Phrase Builder & Backing Track Simulator -->
        <div class="card">
            <h2>🎛️ Phrase Builder & Backing Simulator</h2>
            <p>Test out sample phrases generated using the formula over a simulated groove structure.</p>
            
            <div class="controls-group">
                <label for="grooveStyle">Backing Groove:</label>
                <select id="grooveStyle">
                    <option value="ambient">Ambient Atmospheric (Am - F - C - G)</option>
                    <option value="blues">Slow Blues Minor Jam (Am7)</option>
                    <option value="rock">Upbeat Melodic Rock (Am - G - F - E)</option>
                </select>
                <button id="playGrooveBtn" onclick="toggleGroove()">▶ Start Rhythm Loop</button>
            </div>

            <div class="player-display">
                <div class="status-text" id="grooveStatus">Status: Rhythm Stopped</div>
                <div class="tab-display" id="tabOutput">e|----------------------------------|
B|----------------------------------|
G|----------------------------------|
D|----------------------------------|
A|----------------------------------|
E|----------------------------------|</div>
                <button onclick="playRandomFormulaLine()">Generate & Play Random Formula Line</button>
            </div>
        </div>

    </div>

    <script>
        // Audio Context Setup for Synthesizer
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        function playTone(freq, duration = 0.3) {
            initAudio();
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            
            // Guitar-like soft triangle wave configuration
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

            // Envelope shape (pluck attack and smooth decay)
            gain.gain.setValueAtTime(0, audioCtx.currentTime);
            gain.gain.linearRampToValueAtTime(0.3, audioCtx.currentTime + 0.02);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        }

        // Fretboard Configuration (Standard E A D G B E)
        // Frequencies for standard tuning open strings up to 12 frets
        const stringsData = [
            { name: 'e', baseFreq: 329.63, notes: ['E','F','F#','G','G#','A','A#','B','C','C#','D','D#','E'] },
            { name: 'B', baseFreq: 246.94, notes: ['B','C','C#','D','D#','E','F','F#','G','G#','A','A#','B'] },
            { name: 'G', baseFreq: 196.00, notes: ['G','G#','A','A#','B','C','C#','D','D#','E','F','F#','G'] },
            { name: 'D', baseFreq: 146.83, notes: ['D','D#','E','F','F#','G','G#','A','A#','B','C','C#','D'] },
            { name: 'A', baseFreq: 110.00, notes: ['A','A#','B','C','C#','D','D#','E','F','F#','G','G#','A'] },
            { name: 'E', baseFreq: 82.41,  notes: ['E','F','F#','G','G#','A','A#','B','C','C#','D','D#','E'] }
        ];

        function getNoteFrequency(stringIndex, fret) {
            let base = stringsData[stringIndex].baseFreq;
            return base * Math.pow(2, fret / 12);
        }

        function buildFretboard() {
            const grid = document.getElementById('fretboardGrid');
            grid.innerHTML = '';
            const mode = document.getElementById('scaleSelect').value;

            stringsData.forEach((stringObj, sIdx) => {
                // String label
                const label = document.createElement('div');
                label.className = 'string-label';
                label.innerText = stringObj.name;
                grid.appendChild(label);

                // Frets 0 to 12
                for (let f = 0; f <= 12; f++) {
                    const cell = document.createElement('div');
                    cell.className = 'fret-cell' + (f === 0 ? ' nut' : '');
                    
                    const noteName = stringObj.notes[f];
                    
                    // Highlight logic based on formula profile
                    let isRoot = (noteName === 'A');
                    let isTarget = (noteName === 'C' || noteName === 'E' || noteName === 'G');
                    let displayNote = false;

                    if (mode === 'formula' && (isRoot || isTarget || noteName === 'D')) {
                        displayNote = true;
                    } else if (mode === 'pentatonic' && (noteName === 'A' || noteName === 'C' || noteName === 'D' || noteName === 'E' || noteName === 'G')) {
                        if (f >= 5 && f <= 8) displayNote = true; // Box 1 area
                    } else if (mode === 'triad' && (noteName === 'A' || noteName === 'C' || noteName === 'E')) {
                        displayNote = true;
                    }

                    if (displayNote || mode === 'triad') {
                        const marker = document.createElement('div');
                        marker.className = 'note-marker';
                        if (isRoot) marker.classList.add('root');
                        else if (isTarget) marker.classList.add('target');
                        
                        marker.innerText = noteName;
                        const freq = getNoteFrequency(sIdx, f);
                        marker.onclick = () => playTone(freq, 0.5);
                        cell.appendChild(marker);
                    }

                    grid.appendChild(cell);
                }
            });
        }

        function updateFretboard() {
            buildFretboard();
        }

        // Sample Motif Sequence Playback
        function playCurrentMotif() {
            // A simple classic melodic formula motif: E -> G -> A -> C -> A
            const sequence = [
                { string: 3, fret: 7, delay: 0 },   // D string, A note
                { string: 2, fret: 5, delay: 250 }, // G string, C note
                { string: 2, fret: 7, delay: 500 }, // G string, D note
                { string: 2, fret: 5, delay: 750 }, // G string, C note
                { string: 3, fret: 7, delay: 1100 } // Resolution back to Root A
            ];

            sequence.forEach(item => {
                setTimeout(() => {
                    let freq = getNoteFrequency(item.string, item.fret);
                    playTone(freq, 0.4);
                }, item.delay);
            });
        }

        // Random Formula Line Generator simulator
        const randomTabs = [
            `e|----------------------------------|\nB|------5--8--5---------------------|\nG|---7-----------7--5--7------------|\nD|------------------------7---------|\nA|----------------------------------|\nE|----------------------------------|`,
            `e|---------8--7---------------------|\nB|---10----------10--8--10----------|\nG|-------------------------9--------|\nD|----------------------------------|\nA|----------------------------------|\nE|----------------------------------|`,
            `e|----------------------------------|\nB|------5---------------------------|\nG|---5-----7--5-----5---------------|\nD|---------------7-----7--5--7------|\nA|----------------------------------|\nE|----------------------------------|`
        ];

        function playRandomFormulaLine() {
            const randomIndex = Math.floor(Math.random() * randomTabs.length);
            document.getElementById('tabOutput').innerText = randomTabs[randomIndex];
            playCurrentMotif();
        }

        // Groove Loop simulator state
        let isGroovePlaying = false;
        let grooveInterval = null;

        function toggleGroove() {
            const btn = document.getElementById('playGrooveBtn');
            const status = document.getElementById('grooveStatus');
            
            initAudio();

            if (!isGroovePlaying) {
                isGroovePlaying = true;
                btn.innerText = "⏹ Stop Rhythm Loop";
                btn.style.backgroundColor = "var(--danger)";
                status.innerText = "Status: Playing Backing Groove Pattern... Practice your phrasing over this!";
                
                // Simple background chord click simulation
                let beat = 0;
                grooveInterval = setInterval(() => {
                    beat = (beat + 1) % 4;
                    // Low root thump on beat 1 and 3
                    if (beat === 0 || beat === 2) {
                        playTone(110, 0.15); // A2 root pulse
                    }
                }, 600); // ~100 BPM tempo feel

            } else {
                isGroovePlaying = false;
                btn.innerText = "▶ Start Rhythm Loop";
                btn.style.backgroundColor = "var(--accent)";
                status.innerText = "Status: Rhythm Stopped";
                clearInterval(grooveInterval);
            }
        }

        function setFormulaStep(index) {
            const cards = document.querySelectorAll('.step-card');
            cards.forEach((c, idx) => {
                if(idx === index) c.classList.add('active');
                else c.classList.remove('active');
            });
        }

        // Initialize Fretboard on load
        window.onload = () => {
            buildFretboard();
        };
    </script>
</body>
</html>
